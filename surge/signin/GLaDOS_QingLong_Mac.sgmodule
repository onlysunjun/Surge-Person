#!name=GLaDOS QingLong Sync (Mac)
#!desc=Capture authenticated GLaDOS email/Cookie on Mac and synchronize multi-account JSON to QingLong. Edit module arguments before enabling.
#!system=mac
#!arguments=ql_url:http://127.0.0.1:5700,ql_token:,ql_client_id:,ql_client_secret:,ql_env_name:GLADOS_ACCOUNTS,dry_run:true
#!arguments-desc=ql_url is QingLong panel root URL (no /open). Use ql_token OR ql_client_id plus ql_client_secret (auto-refresh). ql_env_name is the target JSON environment variable; dry_run=true only previews changes, set false to write. Secrets are stored in local module configuration.

[Script]
GLaDOS-Capture-Email = type=http-response, pattern=^https://glados\.network/api/user/status(?:\?.*)?$, script-path=glados_ql_capture.js, requires-body=true, max-size=65536, timeout=15, debug=true
GLaDOS-Sync-QingLong = type=cron, cronexp="*/5 * * * *", script-path=glados_ql_sync.js, argument="{{{ql_url}}}|||GLADOS|||{{{ql_token}}}|||GLADOS|||{{{ql_client_id}}}|||GLADOS|||{{{ql_client_secret}}}|||GLADOS|||{{{ql_env_name}}}|||GLADOS|||{{{dry_run}}}", timeout=45, debug=true

[MITM]
hostname = %APPEND% glados.network
