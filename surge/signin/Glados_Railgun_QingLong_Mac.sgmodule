#!name=GLaDOS + Railgun → 青龙即时同步 V6 (Mac 5)
#!desc=GLaDOS/Railgun 共用青龙；每次有效 Cookie 捕获立即通知，同步结束再通知；按邮箱更新不同变量；gzip 兼容，无定时。
#!system=mac
#!arguments=ql_url:http://127.0.0.1:5700,ql_token:UNSET,ql_client_id:UNSET,ql_client_secret:UNSET,glados_env_name:GLADOS_ACCOUNTS,railgun_env_name:RAILGUN_ACCOUNTS,dry_run:true,notify:true
#!arguments-desc=两个网站使用同一青龙连接但分别保存账号；建议 dry_run:true 预览，确认后改 false。notify:true 每次会有抓取与结果两条通知。

[Script]
GLaDOS-Railgun-Instant-V6 = type=http-response, pattern=^https://(glados\.network|railgun\.info)/api/user/status(?:\?.*)?$, script-path=glados_railgun_capture_sync.js, argument="{{{ql_url}}}|||SITES|||{{{ql_token}}}|||SITES|||{{{ql_client_id}}}|||SITES|||{{{ql_client_secret}}}|||SITES|||{{{glados_env_name}}}|||SITES|||{{{railgun_env_name}}}|||SITES|||{{{dry_run}}}|||SITES|||{{{notify}}}", requires-body=true, max-size=65536, timeout=16, debug=true

[Header Rewrite]
http-request ^https://glados\.network/api/user/status(?:\?.*)?$ header-del Accept-Encoding
http-request ^https://glados\.network/api/user/status(?:\?.*)?$ header-add Accept-Encoding gzip
http-request ^https://railgun\.info/api/user/status(?:\?.*)?$ header-del Accept-Encoding
http-request ^https://railgun\.info/api/user/status(?:\?.*)?$ header-add Accept-Encoding gzip

[MITM]
hostname = %APPEND% glados.network, railgun.info
